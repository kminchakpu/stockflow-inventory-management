@page "/admin/categories"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = StockFlow.Constants.Roles.Admin)]
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using StockFlow.Data
@using StockFlow.Models
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Categories</PageTitle>

<h1>Categories</h1>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<EditForm Model="@editModel" OnValidSubmit="@SaveAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="category-name" class="form-label">Name</label>
        <InputText id="category-name" class="form-control" @bind-Value="editModel.Name" />
        <ValidationMessage For="@(() => editModel.Name)" />
    </div>

    <div class="mb-3">
        <label for="category-description" class="form-label">Description</label>
        <InputTextArea id="category-description" class="form-control" @bind-Value="editModel.Description" />
        <ValidationMessage For="@(() => editModel.Description)" />
    </div>

    <button class="btn btn-primary" type="submit">
        @(isEditing ? "Save changes" : "Add category")
    </button>

    @if (isEditing)
    {
        <button class="btn btn-secondary ms-2" type="button" @onclick="CancelEdit">
            Cancel
        </button>
    }
</EditForm>

<hr />

@if (categories.Count == 0)
{
    <p>No categories yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in categories)
            {
                <tr @key="category.CategoryId">
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                    <td>@category.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => Edit(category)">
                            Edit
                        </button>

                        <button class="btn btn-sm btn-outline-danger ms-2" type="button"
                                @onclick="() => DeleteAsync(category.CategoryId)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Category> categories = new();
    private Category editModel = new();
    private bool isEditing;
    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        categories = await db.Categories
            .AsNoTracking()
            .OrderBy(category => category.Name)
            .ToListAsync();
    }

    private async Task SaveAsync()
    {
        errorMessage = null;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (isEditing)
        {
            var category = await db.Categories.FindAsync(editModel.CategoryId);

            if (category is null)
            {
                errorMessage = "That category could not be found.";
                await LoadAsync();
                CancelEdit();
                return;
            }

            category.Name = editModel.Name.Trim();
            category.Description = CleanDescription(editModel.Description);
        }
        else
        {
            db.Categories.Add(new Category
            {
                Name = editModel.Name.Trim(),
                Description = CleanDescription(editModel.Description)
            });
        }

        await db.SaveChangesAsync();

        CancelEdit();
        await LoadAsync();
    }

    private void Edit(Category category)
    {
        errorMessage = null;
        isEditing = true;

        editModel = new Category
        {
            CategoryId = category.CategoryId,
            Name = category.Name,
            Description = category.Description,
            CreatedAt = category.CreatedAt
        };
    }

    private async Task DeleteAsync(int categoryId)
    {
        errorMessage = null;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Delete this category?");

        if (!confirmed)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var category = await db.Categories.FindAsync(categoryId);

        if (category is null)
        {
            errorMessage = "That category could not be found.";
            await LoadAsync();
            return;
        }

        db.Categories.Remove(category);

        try
        {
            await db.SaveChangesAsync();
            await LoadAsync();
        }
        catch (DbUpdateException)
        {
            errorMessage =
                "This category could not be deleted. It may still be assigned to products.";
        }
    }

    private void CancelEdit()
    {
        editModel = new Category();
        isEditing = false;
        errorMessage = null;
    }

    private static string? CleanDescription(string? description)
    {
        return string.IsNullOrWhiteSpace(description)
            ? null
            : description.Trim();
    }
}
