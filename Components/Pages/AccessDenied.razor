@page "/access-denied"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
<PageTitle>StockFlow | Access denied</PageTitle>
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-form-panel access-denied-panel">
            <div class="auth-header">
                <span class="eyebrow">Access denied</span>
                <h3>You do not have permission to view this page.</h3>
            </div>
            <p>The page you tried to open is restricted to a different role.</p>
            <a href="/dashboard" class="primary-button access-denied-link">Return to dashboard</a>
        </div>
    </div>
</div>
